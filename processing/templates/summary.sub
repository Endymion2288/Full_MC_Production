# ==============================================================================
# summary.sub - DAG 汇总节点
# ==============================================================================

Universe = vanilla

Executable = /bin/bash
transfer_executable = False
Arguments = "-lc 'set -euo pipefail; tar -xzf $(summary_bundle_name); cd runtime/processing/templates; bash summary.sh'"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT
Transfer_Input_Files = $(summary_bundle_path)

Output = $(log_root)/summary_$(Cluster)_$(Process).stdout
Error  = $(log_root)/summary_$(Cluster)_$(Process).stderr
Log    = $(log_root)/summary_$(Cluster)_$(Process).log

request_cpus = 1
request_memory = 1GB
request_disk = 1GB

Queue 1
