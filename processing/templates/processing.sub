# ==============================================================================
# processing.sub - shower/mix/CMSSW 处理节点 submit 模板 (通用)
# ==============================================================================
# 支持本地和远程 HTCondor 集群
# 通过环境变量或 DAG VARS 控制路径
# ==============================================================================

Universe = vanilla

Executable = /bin/bash
transfer_executable = False
Arguments = "-lc 'set -euo pipefail; tar -xzf $(proxy_bundle_name); install -m 600 credentials/x509_user_proxy /tmp/x509up_u$UID; rm -rf credentials; unset X509_USER_PROXY; tar -xzf $(processing_bundle_name); cd runtime/processing; bash run_chain.sh --inputs $(inputs) --modes $(modes) --analysis $(analysis) --campaign $(campaign) --job-id $(job_id) --max-events $(max_events) --enable-ntuple $(enable_ntuple) --cleanup $(cleanup)'"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT

Transfer_Input_Files = $(processing_bundle_path), $(proxy_bundle_path)

transfer_output_files =

Output = /dev/null
Error  = /dev/null
Log    = proc_$(campaign)_$(job_id)_$(Cluster)_$(Process).log

request_cpus = $(request_cpus)
request_memory = $(request_memory)
request_disk = $(request_disk)

getenv = True
+MaxRuntime = 604800

Environment = "HOME=/srv RAW_THREADS=1 RAW_STREAMS=1 RAW_WATCHDOG_TIMEOUT=7200s RAW_WATCHDOG_KILL_AFTER=300s RAW_CMSDRIVER_TIMEOUT=600s PREMIX_INPUT_MODE=$(PREMIX_INPUT_MODE) PREMIX_REDIRECTOR=$(PREMIX_REDIRECTOR) PREMIX_CACHE_FILES=$(PREMIX_CACHE_FILES) PREMIX_CACHE_TIMEOUT=7200s PREMIX_CACHE_RETRIES=3 PREMIX_CACHE_REDIRECTOR=$(PREMIX_CACHE_REDIRECTOR) PREMIX_LOCAL_POOL_DIR=$(PREMIX_LOCAL_POOL_DIR) PREMIX_LOCAL_POOL_FILES=$(PREMIX_LOCAL_POOL_FILES)"

# Container handled manually in run_chain.sh for CMSSW steps

OnExitHold = (ExitCode != 0)
OnExitHoldReason = "Processing chain failed"
OnExitHoldSubCode = 1
PeriodicRelease = (JobRunCount < 2) && (HoldReasonCode == 3)

Queue 1
