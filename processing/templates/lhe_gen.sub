# ==============================================================================
# lhe_gen.sub - LHE 生成节点 submit 模板 (通用)
# ==============================================================================
# 支持本地和远程 HTCondor 集群
# 通过环境变量或 DAG VARS 控制路径
# ==============================================================================

Universe = vanilla

Executable = /bin/bash
transfer_executable = False
Arguments = "-lc 'set -euo pipefail; tar -xzf $(proxy_bundle_name); install -m 600 credentials/x509_user_proxy /tmp/x509up_u$UID; rm -rf credentials; unset X509_USER_PROXY; tar -xzf $(lhe_bundle_name); cd runtime/lhe_generation; bash run_helac.sh --pool $(pool) --seed $(seed) --min-pt-conia $(min_pt_conia) --min-pt-bonia $(min_pt_bonia) --min-pt-q $(min_pt_q) --unwevt $(unwevt) --test-mode $(test_mode) --output-dir $(lhe_output_dir)'"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT

Transfer_Input_Files = $(lhe_bundle_path), $(proxy_bundle_path)

transfer_output_files =

Output = /dev/null
Error  = /dev/null
Log    = lhe_$(pool)_$(seed)_$(Cluster)_$(Process).log

request_cpus = $(request_cpus)
request_memory = $(request_memory)
request_disk = $(request_disk)

getenv = True
+MaxRuntime = 604800

requirements = (TARGET.Machine != "nd-11.hepthu.com")

Environment = "HOME=/srv"

# el7 container for HELAC-Onia compilation
+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el7:x86_64"

OnExitHold = (ExitCode != 0)
OnExitHoldReason = "LHE generation failed"
OnExitHoldSubCode = 1
PeriodicRelease = (JobRunCount < 2) && (HoldReasonCode == 3)

Queue 1